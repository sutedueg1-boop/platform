# ============================================================
# نسخة مثال لملف .env — انسخه لملف اسمه .env واملأ القيم الحقيقية
# (ملف .env نفسه غير موجود في git عمدًا — .gitignore)
# ============================================================

# --- أساسيات السيرفر (موجودة بالفعل، لازم تفضل زي ما هي) ---
JWT_SECRET=غيّره_لقيمة_عشوائية_طويلة_وسرية
JWT_EXPIRES_IN=30m
PORT=3000
BCRYPT_ROUNDS=12

# --- تكامل واتساب (WhatsApp Cloud API by Meta) — اختياري ---
# من غير القيم دي، ميزة تنبيهات الواتساب والشات بوت عبر واتساب تبقى
# "معطّلة بأمان" تلقائيًا (باقي السيستم يشتغل عادي زي ما هو دلوقتي).
# راجع تعليقات lib/whatsapp.js للتفاصيل الكاملة لكل خطوة.
#
#   1) سجّل دخول على developers.facebook.com وأنشئ App نوعه "Business"
#   2) أضف منتج "WhatsApp" للـ App، وهتلاقي رقم تجريبي + Access Token
#   3) حط القيم التلاتة دي (احذف الـ # من أول كل سطر بعد ما تملأها):
#
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=اختار_أنت_أي_نص_سري_هنا
# WHATSAPP_API_VERSION=v20.0
#
# App Secret من developers.facebook.com > تطبيقك > App settings > Basic.
# السيرفر بيستخدمه يتأكد إن رسائل الـ webhook جاية من ميتا فعلًا — من غيره
# أي رسالة واردة (زي ضغطة زر قبول/رفض بلاغ) بتترفض.
# WHATSAPP_APP_SECRET=

# --- مساعد السلامة الذكي: طبقة الذكاء الاصطناعي (اختيارية) ---
#
# ★ الخيار المجاني (المفضّل لو مش عايز تدفع): Google Gemini
#   من غير فيزا ولا رصيد — مفتاح مجاني من: https://aistudio.google.com/apikey
#   سجّل دخول بجوجل ← Create API key ← انسخه وحطه هنا:
# GEMINI_API_KEY=
#
#   ⚠️ مهم تعرفه: جوجل بتقول إن محتوى النسخة المجانية ممكن يُستخدم في
#   تحسين خدماتهم. عشان كده الطبقة دي مبرمجة إنها **ما تبعتش** أي أسماء
#   موظفين ولا أرقام تليفونات ولا بيانات بلاغات — بس السؤال نفسه + مقاطع
#   تعليمات السلامة (وهي مستندات عامة) + دور السائل وقسمه.
#   لو ده مش مقبول لسياسة الشركة، سيب الخانة فاضية والشات بوت هيفضل
#   شغال محليًا زي دلوقتي بالظبط.
#
# لو حبيت تحدد المزوّد صراحة (لما يكون عندك الاتنين):
# CHATBOT_LLM_PROVIDER=gemini
#
# --- البديل المدفوع: Claude (أقوى في العامية، بس بفلوس) ---
# من غير المفتاح ده الشات بوت بيشتغل بالطبقات المحلية بس — بالظبط زي ما هو
# دلوقتي، من غير أي رسالة خطأ. مع المفتاح: أي سؤال الطبقات المحلية ماعرفتش
# ترد عليه بيروح لـ Claude، وبيصيغ الإجابة من نفس مقاطع تعليمات السلامة
# الموثقة (ممنوع عليه يخترع معلومة مش في المصادر).
#
# اللي بيخرج من المصنع وقت التفعيل: سؤال المستخدم + مقاطع التعليمات
# المطابقة + دور المستخدم وقسمه. مفيش أسماء موظفين ولا تليفونات ولا
# بيانات بلاغات/تصاريح بتتبعت.
#
#   المفتاح من: console.anthropic.com ← API Keys
# ANTHROPIC_API_KEY=
#
# اختياري: الموديل (الافتراضي claude-opus-5 — الأقوى في فهم العامية).
# للتوفير: claude-sonnet-5 أو claude-haiku-4-5
# CHATBOT_LLM_MODEL=claude-opus-5
# CHATBOT_LLM_EFFORT=low
# CHATBOT_LLM_TIMEOUT_MS=20000

# --- HTTPS لشبكة المصنع الداخلية (اختياري) ---
# المتصفحات بتمنع المايك والإشعارات على أي عنوان http غير localhost.
# لو العمال بيفتحوا المنصة من موبايلاتهم على IP الشبكة، فعّل ده عشان
# المايك في الشات بوت يشتغل عندهم:
# ENABLE_HTTPS=true
# HTTPS_PORT=3443
# (الشهادة بتتولّد لوحدها في data/ssl — المتصفح هيحذّر أول مرة وده طبيعي)

# --- جلسة العامل ---
# مدة صلاحية دخول العامل بكلمة السر قبل ما يطلب منه يدخل تاني (افتراضي 30 يوم)
# WORKER_JWT_EXPIRES_IN=30d

# --- إيميل النسخة الاحتياطية اليومية (SMTP) — اختياري ---
# من غير القيم دي، زرار "ابعت النسخة دلوقتي" والإرسال اليومي بيقولوا إن
# الإيميل مش متظبط (باقي السيستم شغال عادي).
#
# Gmail: فعّل التحقق بخطوتين على الحساب، وبعدين اعمل "App Password" من
#        https://myaccount.google.com/apppasswords وحطه في SMTP_PASS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=
# SMTP_FROM="HSE Platform <your.account@gmail.com>"
#
# Outlook / Office 365 بدل Gmail:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
